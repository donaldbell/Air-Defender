// --------------------------------------------------------------------------
// 4. AUDIO SYSTEM  
// --------------------------------------------------------------------------
Melody parseSoundString(String data) {
  Melody result;
  if (data.length() < 3) return result;
  
  int pos = 0;
  while (pos < data.length()) {
    int commaPos = data.indexOf(',', pos);
    int semicolonPos = data.indexOf(';', pos);
    
    if (commaPos != -1 && (semicolonPos == -1 || commaPos < semicolonPos)) {
      ToneCmd t;
      t.freq = data.substring(pos, commaPos).toInt();
      pos = commaPos + 1;
      
      int nextDelim = data.indexOf(';', pos);
      if (nextDelim == -1) nextDelim = data.length();
      t.duration = data.substring(pos, nextDelim).toInt();
      result.push_back(t);
      pos = nextDelim + 1;
    } else {
      break;
    }
  }
  
  if (result.empty()) {
    ToneCmd t;
    t.freq = 440;
    t.duration = 100;
    result.push_back(t);
  }
  
  return result;
}

void melodyFromStr(Melody& m, String s) { 
  m = parseSoundString(s); 
}

void playSound(SoundEvent evt) {
  if (!config_sound_on || audioQueue == nullptr) {
    Serial.printf("Audio disabled - sound event %d ignored\n", evt);
    return;
  }
  
  BaseType_t result = xQueueSend(audioQueue, &evt, 0);
  if (result == pdTRUE) {
    Serial.printf("✓ Audio event %d queued successfully\n", evt);
  } else {
    Serial.printf("✗ Failed to queue audio event %d\n", evt);
  }
}

void playShotSound(int color) {
  if (!config_sound_on) {
    Serial.printf("Audio disabled - shot sound for color %d ignored\n", color);
    return;
  }
  
  switch(color) {
    case 1: playSound(EVT_SHOT_BLUE); break;
    case 2: playSound(EVT_SHOT_RED); break;
    case 3: playSound(EVT_SHOT_GREEN); break;
    case 7: playSound(EVT_SHOT_WHITE); break;
    default: playSound(EVT_SHOT_BLUE); break;
  }
}

void playToneI2S(int freq, int durationMs) {
  static int toneCount = 0;
  toneCount++;
  
  Serial.printf("[Tone %d] Freq: %dHz, Duration: %dms, Volume: %d%%\n", 
                toneCount, freq, durationMs, config_volume_pct);
  
  if (freq <= 0) {
    // Play silence
    size_t bytes_written;
    int samples = (SAMPLE_RATE * durationMs) / 1000;
    int16_t *buffer = (int16_t *)calloc(samples, sizeof(int16_t));
    if (buffer) {
      Serial.printf("[Tone %d] Playing silence: %d samples\n", toneCount, samples);
      esp_err_t result = i2s_write(I2S_NUM_0, buffer, samples * sizeof(int16_t), &bytes_written, portMAX_DELAY);
      Serial.printf("[Tone %d] Silence written: %d/%d bytes (result: %d)\n", 
                    toneCount, bytes_written, samples * sizeof(int16_t), result);
      free(buffer);
    } else {
      Serial.printf("[Tone %d] Failed to allocate silence buffer\n", toneCount);
    }
    return;
  }
  
  size_t bytes_written;
  int samples = (SAMPLE_RATE * durationMs) / 1000;
  int16_t *buffer = (int16_t *)malloc(samples * sizeof(int16_t));
  if (!buffer) {
    Serial.printf("[Tone %d] Failed to allocate audio buffer (%d bytes needed)\n", 
                  toneCount, samples * sizeof(int16_t));
    return;
  }
  
  int halfPeriod = SAMPLE_RATE / freq / 2;
  int16_t volume = map(config_volume_pct, 0, 100, 0, 8192); // Reduced max volume
  
  Serial.printf("[Tone %d] Buffer: %d samples, Half period: %d, Volume: %d\n", 
                toneCount, samples, halfPeriod, volume);
  
  // Generate square wave
  for (int i = 0; i < samples; i++) {
    buffer[i] = ((i / halfPeriod) % 2 == 0) ? volume : -volume;
  }
  
  // Check buffer values
  Serial.printf("[Tone %d] Sample check - First: %d, Mid: %d, Last: %d\n", 
                toneCount, buffer[0], buffer[samples/2], buffer[samples-1]);
  
  esp_err_t result = i2s_write(I2S_NUM_0, buffer, samples * sizeof(int16_t), &bytes_written, portMAX_DELAY);
  
  Serial.printf("[Tone %d] I2S write result: %d, Bytes: %d/%d (%.1f%% written)\n", 
                toneCount, result, bytes_written, samples * sizeof(int16_t),
                (float)bytes_written / (samples * sizeof(int16_t)) * 100.0);
  
  if (result != ESP_OK) {
    Serial.printf("[Tone %d] I2S write ERROR: %d (ESP_ERR_TIMEOUT=%d)\n", 
                  toneCount, result, ESP_ERR_TIMEOUT);
  }
  
  free(buffer);
}

void audioTask(void *parameter) {
  Serial.println("Audio task starting...");
  Serial.printf("Task running on core: %d\n", xPortGetCoreID());
  Serial.printf("Free heap in audio task: %d bytes\n", ESP.getFreeHeap());
  
  i2s_config_t i2s_config = {
    .mode = (i2s_mode_t)(I2S_MODE_MASTER | I2S_MODE_TX),
    .sample_rate = SAMPLE_RATE,
    .bits_per_sample = I2S_BITS_PER_SAMPLE_16BIT,
    .channel_format = I2S_CHANNEL_FMT_ONLY_LEFT, 
    .communication_format = I2S_COMM_FORMAT_STAND_I2S,
    .intr_alloc_flags = ESP_INTR_FLAG_LEVEL1,
    .dma_buf_count = 4,
    .dma_buf_len = 512,
    .use_apll = false,
    .tx_desc_auto_clear = true
  };
  
  i2s_pin_config_t pin_config = {
    .bck_io_num = I2S_BCLK,
    .ws_io_num = I2S_LRC,
    .data_out_num = I2S_DOUT,
    .data_in_num = I2S_PIN_NO_CHANGE 
  };

  // Verify GPIO pins are available
  Serial.printf("Verifying GPIO pins - BCLK: %d, LRC: %d, DOUT: %d, SD: %d\n", 
                I2S_BCLK, I2S_LRC, I2S_DOUT, I2S_SD);
  
  Serial.println("Installing I2S driver...");
  esp_err_t result = i2s_driver_install(I2S_NUM_0, &i2s_config, 0, NULL);
  if (result == ESP_OK) {
    Serial.println("✓ I2S driver installed successfully");
  } else {
    Serial.printf("✗ I2S driver install failed: %d (ESP_ERR_NO_MEM=%d, ESP_ERR_INVALID_ARG=%d)\n", 
                  result, ESP_ERR_NO_MEM, ESP_ERR_INVALID_ARG);
    vTaskDelete(NULL);
    return;
  }
  
  Serial.println("Setting I2S pins...");
  result = i2s_set_pin(I2S_NUM_0, &pin_config);
  if (result == ESP_OK) {
    Serial.println("✓ I2S pins configured successfully");
  } else {
    Serial.printf("✗ I2S pin config failed: %d\n", result);
    i2s_driver_uninstall(I2S_NUM_0);
    vTaskDelete(NULL);
    return;
  }
  
  // Start I2S driver
  Serial.println("Starting I2S driver...");
  result = i2s_start(I2S_NUM_0);
  if (result == ESP_OK) {
    Serial.println("✓ I2S driver started successfully");
  } else {
    Serial.printf("✗ I2S driver start failed: %d\n", result);
  }
  
  i2s_zero_dma_buffer(I2S_NUM_0);
  
  // Test a brief tone to verify audio path
  Serial.println("Testing audio path with 440Hz tone...");
  playToneI2S(440, 100);
  delay(200);
  
  Serial.println("✓ Audio task initialized and ready");

  const Melody* currentMelody = nullptr;
  int noteIndex = 0;
  unsigned long debugTimer = 0;
  int soundsPlayed = 0;
  
  while(true) {
    // Periodic I2S status check
    if (millis() - debugTimer > 10000) { // Every 10 seconds
      debugTimer = millis();
      Serial.printf("I2S Status Check: Sounds played: %d, Free heap: %d bytes\n", 
                    soundsPlayed, ESP.getFreeHeap());
      
      // Debug test beep removed - audio system confirmed working
    }
    
    SoundEvent newEvent;
    if (xQueueReceive(audioQueue, &newEvent, 10) == pdTRUE) {
      Serial.printf("Processing audio event: %d (Queue messages waiting: %d)\n", 
                    newEvent, uxQueueMessagesWaiting(audioQueue));
      
      bool play = true;
      if ((currentMelody == &melWin || currentMelody == &melLose) && newEvent != EVT_START) {
        play = false;
        Serial.println("Ignoring event - priority melody playing");
      }
      
      if (play) {
        switch(newEvent) {
          case EVT_START:      currentMelody = &melStart; Serial.println("Playing start melody"); break;
          case EVT_SHOT_BLUE:  currentMelody = &melShotBlue; Serial.println("Playing blue shot"); break;
          case EVT_SHOT_RED:   currentMelody = &melShotRed; Serial.println("Playing red shot"); break;
          case EVT_SHOT_GREEN: currentMelody = &melShotGreen; Serial.println("Playing green shot"); break;
          case EVT_SHOT_WHITE: currentMelody = &melShotWhite; Serial.println("Playing white shot"); break;
          case EVT_MISTAKE:    currentMelody = &melMistake; Serial.println("Playing mistake sound"); break;
          case EVT_HIT_SUCCESS:currentMelody = &melHit; Serial.println("Playing hit sound"); break;
          case EVT_WIN:        currentMelody = &melWin; Serial.println("Playing win melody"); break;
          case EVT_LOSE:       currentMelody = &melLose; Serial.println("Playing lose melody"); break;
          default: Serial.printf("Unknown audio event: %d\n", newEvent); break;
        }
        noteIndex = 0;
        i2s_zero_dma_buffer(I2S_NUM_0);
        soundsPlayed++;
      }
    }

    if (currentMelody != nullptr) {
      if (noteIndex >= currentMelody->size()) {
        Serial.printf("Melody finished (played %d notes)\n", noteIndex);
        currentMelody = nullptr; 
        playToneI2S(0, 20); 
        i2s_zero_dma_buffer(I2S_NUM_0);
      } else {
        ToneCmd t = (*currentMelody)[noteIndex];
        Serial.printf("Playing note %d/%d: %dHz for %dms\n", 
                      noteIndex+1, currentMelody->size(), t.freq, t.duration);
        playToneI2S(t.freq, t.duration);
        noteIndex++;
      }
    } else {
      vTaskDelay(pdMS_TO_TICKS(10)); 
    }
  }
}

// --------------------------------------------------------------------------
// 5. BUTTON HANDLING
// --------------------------------------------------------------------------
void readButtons() {
  if (millis() - lastButtonCheck > 15) { // Reduced debounce for rapid firing
    lastButtonCheck = millis();
    
    // Store previous button states for debouncing
    lastBtBlue = btBlue;
    lastBtRed = btRed;
    lastBtGreen = btGreen;
    lastBtWhite = btWhite;
    lastBtSoundToggle = btSoundToggle;
    
    // Read current button states
    btBlue = !digitalRead(PIN_BUTTON_BLUE);
    btRed = !digitalRead(PIN_BUTTON_RED);
    btGreen = !digitalRead(PIN_BUTTON_GREEN);
    btWhite = !digitalRead(PIN_BUTTON_WHITE);
    btSoundToggle = !digitalRead(PIN_SOUND_TOGGLE);
    
    // Handle sound toggle switch (on press, not hold)
    if (btSoundToggle && !lastBtSoundToggle) {
      config_sound_on = !config_sound_on;
      preferences.putBool("sound_on", config_sound_on);
      Serial.printf("Sound %s via hardware switch\n", config_sound_on ? "ENABLED" : "DISABLED");
      
      if (config_sound_on) {
        // Flash LEDs green to indicate sound enabled
        fill_solid(leds, config_num_leds, CRGB::Green);
        FastLED.show();
        delay(200);
      } else {
        // Flash LEDs red to indicate sound disabled
        fill_solid(leds, config_num_leds, CRGB::Red);
        FastLED.show();
        delay(200);
      }
    }
  }
}

// --------------------------------------------------------------------------
// 6. GAME LOGIC FUNCTIONS  
// --------------------------------------------------------------------------
void saveHighscores() {
  preferences.begin("game", false);
  for (int i = 0; i < 5; i++) {
    String key = "hs" + String(i);
    preferences.putInt(key.c_str(), highScores[i]);
  }
  preferences.end();
}

void loadHighscores() {
  preferences.begin("game", true);
  for (int i = 0; i < 5; i++) {
    String key = "hs" + String(i);
    highScores[i] = preferences.getInt(key.c_str(), 0);
  }
  preferences.end();
}

bool addHighScore(int score) {
  bool newRecord = false;
  for (int i = 0; i < 5; i++) {
    if (score > highScores[i]) {
      // Shift scores down
      for (int j = 4; j > i; j--) {
        highScores[j] = highScores[j-1];
      }
      highScores[i] = score;
      newRecord = true;
      break;
    }
  }
  if (newRecord) saveHighscores();
  return newRecord;
}

void resetGame() {
  currentLevel = config_start_level;
  currentScore = 0;
  livesRemaining = 3;
  won = false;
  playerPosition = 0;
  enemyFrontIndex = config_num_leds - 1;
  updateLevelPalette(); // Set palette for starting level
  
  shots.clear();
  enemies.clear();
  bossSegments.clear();
  bossProjectiles.clear();
}

void checkWinCondition() {
  won = false;
  if (currentState == STATE_PLAYING && enemies.empty()) won = true;
  if (currentState == STATE_BOSS_PLAYING && bossSegments.empty()) won = true;
  
  if (won) {
    // Clear all game entities immediately when entering victory state
    enemies.clear();
    shots.clear(); 
    bossProjectiles.clear();
    bossSegments.clear();
    
    addHighScore(currentScore);
    currentState = STATE_WIN_SCREEN;
    stateStartTime = millis();
    playSound(EVT_WIN);  // Victory sound
  }
}

void checkLoseCondition() {
  // Check if enemies reached player
  bool enemyReachedPlayer = false;
  for (const auto& enemy : enemies) {
    if (enemy.position <= 0) {
      enemyReachedPlayer = true;
      break;
    }
  }
  
  // Check boss projectiles hit player  
  for (const auto& proj : bossProjectiles) {
    if (proj.position <= 0) {
      enemyReachedPlayer = true;
      break;
    }
  }
  
  if (enemyReachedPlayer) {
    livesRemaining--;
    if (livesRemaining <= 0) {
      addHighScore(currentScore);
      currentState = STATE_LOSE_SCREEN;
      stateStartTime = millis();
      playSound(EVT_LOSE);  // Game over sound
    } else {
      // Reset positions for new life
      shots.clear();
      bossProjectiles.clear();
      enemyFrontIndex = config_num_leds - 1;
      for (auto& enemy : enemies) {
        enemy.position = enemyFrontIndex + enemy.originalIndex * 10;
      }
    }
  }
}

void spawnEnemies() {
  enemies.clear();
  enemyFrontIndex = config_num_leds - 1; // Reset enemy front position to start of strip
  int numEnemies = 5 + currentLevel * 2;
  if (numEnemies > 20) numEnemies = 20;
  
  for (int i = 0; i < numEnemies; i++) {
    Enemy enemy;
    enemy.position = enemyFrontIndex + i * 10;
    enemy.color = random(1, 4); // Randomize colors (RGB only)
    enemy.active = true;
    enemy.speed = 0.2 + currentLevel * 0.1;
    enemy.originalIndex = i;
    enemies.push_back(enemy);
  }
}

void updateLevelIntro() {
  if (millis() - stateStartTime > 3000) {
    if (currentLevel % 5 == 0) {
      // Boss level
      bossSegments.clear(); enemies.clear(); shots.clear(); bossProjectiles.clear();
      currentState = STATE_BOSS_INTRO;
      stateStartTime = millis();
    } else {
      // Regular level
      enemies.clear(); shots.clear(); bossProjectiles.clear();
      spawnEnemies();
      currentState = STATE_PLAYING;
      levelStartTime = millis();
    }
  }
}

void spawnBoss() {
  bossSegments.clear();
  enemyFrontIndex = config_num_leds - 1; // Reset boss front position to start of strip
  BossConfig cfg;
  int bossNumber = currentLevel / 5;
  
  switch(bossNumber) {
    case 1: cfg = boss1Cfg; break;
    case 2: cfg = boss2Cfg; break;
    default: cfg = boss3Cfg; break;
  }
  
  for (int i = 0; i < cfg.numSegments; i++) {
    BossSegment seg;
    seg.position = enemyFrontIndex + i * 5;
    seg.color = random(1, 4); // Randomize boss colors too
    seg.active = true;
    seg.originalIndex = i;
    bossSegments.push_back(seg);
  }
  
  boss2State = B2_CHARGE;
  boss3State = B3_SPIN;
  boss2Section = 0;
  bossActionTimer = millis();
}

void updateBossIntro() {
  if (millis() - stateStartTime > 3000) {
    spawnBoss();
    currentState = STATE_BOSS_PLAYING;
    levelStartTime = millis();  // Set level start time for boss levels
    stateStartTime = millis();
  }
}

void moveBossProjectiles(float deltaTime) {
  for(int i=bossProjectiles.size()-1; i>=0; i--) {
    bossProjectiles[i].position -= 50 * deltaTime;
    if (bossProjectiles[i].position < 0) {
      bossProjectiles.erase(bossProjectiles.begin() + i);
    }
  }
}

void loadColors() {
  preferences.begin("colors", true);
  // Load hex color strings and convert to CRGB
  String hex_c1 = preferences.getString("c1", "0000FF");
  String hex_c2 = preferences.getString("c2", "FF0000"); 
  String hex_c3 = preferences.getString("c3", "00FF00");
  String hex_c4 = preferences.getString("c4", "FFFFFF");
  String hex_c5 = preferences.getString("c5", "FFFF00");
  String hex_c6 = preferences.getString("c6", "FF00FF");
  String hex_cw = preferences.getString("cw", "FFA500");
  String hex_cb = preferences.getString("cb", "800080");
  
  c1 = CRGB(strtol(hex_c1.c_str(), NULL, 16));
  c2 = CRGB(strtol(hex_c2.c_str(), NULL, 16));
  c3 = CRGB(strtol(hex_c3.c_str(), NULL, 16));
  c4 = CRGB(strtol(hex_c4.c_str(), NULL, 16));
  c5 = CRGB(strtol(hex_c5.c_str(), NULL, 16));
  c6 = CRGB(strtol(hex_c6.c_str(), NULL, 16));
  cWall = CRGB(strtol(hex_cw.c_str(), NULL, 16));
  cBoss = CRGB(strtol(hex_cb.c_str(), NULL, 16));
  
  preferences.end();
}

void handleSaveColors() {
  String hex_c1, hex_c2, hex_c3, hex_c4, hex_c5, hex_c6, hex_cw, hex_cb;
  
  if(server.hasArg("c1")) hex_c1 = server.arg("c1");
  if(server.hasArg("c2")) hex_c2 = server.arg("c2");
  if(server.hasArg("c3")) hex_c3 = server.arg("c3");
  if(server.hasArg("c4")) hex_c4 = server.arg("c4");
  if(server.hasArg("c5")) hex_c5 = server.arg("c5");
  if(server.hasArg("c6")) hex_c6 = server.arg("c6");
  if(server.hasArg("cw")) hex_cw = server.arg("cw");
  if(server.hasArg("cb")) hex_cb = server.arg("cb");
  
  preferences.begin("colors", false);
  preferences.putString("c1", hex_c1);
  preferences.putString("c2", hex_c2);
  preferences.putString("c3", hex_c3);
  preferences.putString("c4", hex_c4);
  preferences.putString("c5", hex_c5);
  preferences.putString("c6", hex_c6);
  preferences.putString("cw", hex_cw);
  preferences.putString("cb", hex_cb);
  preferences.end();
  
  loadColors();
  
  server.sendHeader("Location", "/colors");
  server.send(303);
}

// Audio configuration functions removed - no longer needed

void saveCurrentToPreferences(String prefix) {
  preferences.begin("game", false);
  preferences.putInt((prefix + "_num_leds").c_str(), config_num_leds);
  preferences.putInt((prefix + "_brightness").c_str(), config_brightness_pct);
  preferences.putInt((prefix + "_start_level").c_str(), config_start_level);
  preferences.putString((prefix + "_ssid").c_str(), config_ssid);
  preferences.putString((prefix + "_pass").c_str(), config_pass);
  preferences.putString((prefix + "_ip").c_str(), config_ip);
  preferences.putString((prefix + "_gateway").c_str(), config_gateway);
  preferences.putString((prefix + "_subnet").c_str(), config_subnet);
  preferences.putString((prefix + "_dns").c_str(), config_dns);
  preferences.putBool((prefix + "_static_ip").c_str(), config_static_ip);
  preferences.end();
}

void performFactoryReset() {
  preferences.begin("game", true);
  preferences.clear();
  preferences.end();
  preferences.begin("colors", true);
  preferences.clear();
  preferences.end();
  preferences.begin("snds", true);
  preferences.clear();
  preferences.end();
  
  // Reset to defaults - reduced for stability
  config_num_leds = 100;
  config_brightness_pct = 50;
  config_start_level = 1;
  config_ssid = "1DEnviroGame";
  config_pass = "password123";
  for (int i = 0; i < 5; i++) highScores[i] = 0;
  loadColors();
}

void loadConfig(String prefix) {
  preferences.begin("game", true);
  config_num_leds = preferences.getInt((prefix + "_num_leds").c_str(), 100);  // Increased default
  config_brightness_pct = preferences.getInt((prefix + "_brightness").c_str(), 50);  // Reduced default
  config_start_level = preferences.getInt((prefix + "_start_level").c_str(), 1);
  config_ssid = preferences.getString((prefix + "_ssid").c_str(), "1DEnviroGame");
  config_pass = preferences.getString((prefix + "_pass").c_str(), "password123");
  config_ip = preferences.getString((prefix + "_ip").c_str(), "192.168.4.1");
  config_gateway = preferences.getString((prefix + "_gateway").c_str(), "192.168.4.1");
  config_subnet = preferences.getString((prefix + "_subnet").c_str(), "255.255.255.0");
  config_dns = preferences.getString((prefix + "_dns").c_str(), "192.168.4.1");
  config_static_ip = preferences.getBool((prefix + "_static_ip").c_str(), false);
  currentProfilePrefix = prefix;
  preferences.end();
}

void handleProfileSwitch() {
  if (server.hasArg("profile")) {
    String newProfile = server.arg("profile");
    saveCurrentToPreferences(currentProfilePrefix);
    preferences.begin("game", false); preferences.putString("act_prof", currentProfilePrefix); preferences.end();
    loadConfig(newProfile);
  }
  server.sendHeader("Location", "/");
  server.send(303);
}

void handleReset() { performFactoryReset(); server.send(200, "text/html", "<h2>Reset successful!</h2><p>Values & Scores wiped. ESP restarting.</p>"); delay(1000); ESP.restart(); }

void handleSave() {
  if (server.hasArg("leds")) config_num_leds = server.arg("leds").toInt(); if (server.hasArg("bright")) config_brightness_pct = server.arg("bright").toInt(); if (server.hasArg("startlvl")) config_start_level = server.arg("startlvl").toInt();
  if (server.hasArg("ssid")) config_ssid = server.arg("ssid"); if (server.hasArg("pass")) config_pass = server.arg("pass");
  config_static_ip = server.hasArg("static_ip"); config_ip = server.arg("ip"); config_gateway = server.arg("gw"); config_subnet = server.arg("sn"); config_dns = server.arg("dns");
  
  // Reallocate LED array if size changed
  if (leds) delete[] leds;
  leds = new CRGB[config_num_leds];
  FastLED.addLeds<LED_TYPE, PIN_LED_DATA, COLOR_ORDER>(leds, config_num_leds);
  FastLED.setBrightness((config_brightness_pct * 255) / 100);
  
  preferences.begin("game", false);
  preferences.putInt("num_leds", config_num_leds);
  preferences.putInt("brightness", config_brightness_pct);
  preferences.putInt("start_level", config_start_level);
  preferences.putString("ssid", config_ssid);
  preferences.putString("pass", config_pass);
  preferences.putString("ip", config_ip);
  preferences.putString("gateway", config_gateway);
  preferences.putString("subnet", config_subnet);
  preferences.putString("dns", config_dns);
  preferences.putBool("static_ip", config_static_ip);
  preferences.end();
  
  server.sendHeader("Location", "/");
  server.send(303);
}

CRGB getColor(int colorIndex) {
  switch(colorIndex) {
    case 1: return c1;
    case 2: return c2;
    case 3: return c3;
    case 4: return c4;
    case 5: return c5;
    case 6: return c6;
    case 7: return cWall;
    case 8: return cBoss;
    default: return CRGB::Black;
  }
}

// Enhanced color system with palettes
void updateLevelPalette() {
  if (currentLevel <= 3) currentPalette = PartyColors_p;
  else if (currentLevel <= 7) currentPalette = HeatColors_p; 
  else if (currentLevel <= 12) currentPalette = OceanColors_p;
  else currentPalette = LavaColors_p;
}

CRGB getEnhancedColor(int colorIndex) {
  uint8_t paletteIndex = map(colorIndex, 1, 3, 0, 240);
  return ColorFromPalette(currentPalette, paletteIndex + gHue, 255, currentBlending);
}

uint8_t breathingBrightness() {
  return beatsin8(12, 80, 255); // Slow breathing effect
}

void enableWiFi() {
  WiFi.mode(WIFI_AP_STA);
  WiFi.softAP(config_ssid.c_str(), config_pass.c_str());
  
  if (config_static_ip) {
    IPAddress ip, gateway, subnet, dns;
    ip.fromString(config_ip);
    gateway.fromString(config_gateway);
    subnet.fromString(config_subnet);
    dns.fromString(config_dns);
    WiFi.softAPConfig(ip, gateway, subnet);
  }
  
  server.begin();
  Serial.print("WiFi AP started: ");
  Serial.println(WiFi.softAPIP());
}

// --------------------------------------------------------------------------
// 7. MAIN SETUP AND LOOP
// --------------------------------------------------------------------------

void setup() {
  Serial.begin(115200);
  delay(1000);
  Serial.println("1D RGB Invader Game - Starting...");
  Serial.printf("Free heap at start: %d bytes\n", ESP.getFreeHeap());
  
  // Initialize buttons with pullups
  pinMode(PIN_BUTTON_BLUE, INPUT_PULLUP);
  pinMode(PIN_BUTTON_RED, INPUT_PULLUP);
  pinMode(PIN_BUTTON_GREEN, INPUT_PULLUP);
  pinMode(PIN_BUTTON_WHITE, INPUT_PULLUP);
  pinMode(PIN_SOUND_TOGGLE, INPUT_PULLUP);
  
  // Initialize I2S SD (Shutdown) pin - must be HIGH to enable amplifier
  pinMode(I2S_SD, OUTPUT);
  digitalWrite(I2S_SD, HIGH);  // Enable amplifier (SD pin active-low)
  Serial.println("I2S amplifier enabled (SD pin set HIGH)");
  
  // Load configuration
  preferences.begin("game", true);
  config_num_leds = preferences.getInt("num_leds", 300);  // Full 300 LEDs
  config_brightness_pct = preferences.getInt("brightness", 40);  // Moderate brightness
  config_start_level = preferences.getInt("start_level", 1);
  config_ssid = preferences.getString("ssid", "1DEnviroGame");
  config_pass = preferences.getString("pass", "password123");
  config_ip = preferences.getString("ip", "192.168.4.1");
  config_gateway = preferences.getString("gateway", "192.168.4.1");
  config_subnet = preferences.getString("subnet", "255.255.255.0");
  config_dns = preferences.getString("dns", "192.168.4.1");
  config_static_ip = preferences.getBool("static_ip", false);
  config_sound_on = preferences.getBool("sound_on", true); // RE-ENABLE AUDIO FOR TESTING
  config_volume_pct = preferences.getInt("volume", 50);
  currentProfilePrefix = preferences.getString("act_prof", "default");
  preferences.end();
  Serial.printf("Config loaded - LEDs: %d, Brightness: %d%%\n", config_num_leds, config_brightness_pct);
  
  // Check if we have enough memory for LED array
  size_t ledMemoryNeeded = config_num_leds * sizeof(CRGB);
  Serial.printf("LED array needs %d bytes\n", ledMemoryNeeded);
  Serial.printf("Free heap before LED allocation: %d bytes\n", ESP.getFreeHeap());
  
  // Initialize LED strip
  leds = new CRGB[config_num_leds];
  if (leds == nullptr) {
    Serial.println("ERROR: Failed to allocate LED array!");
    while(1) delay(1000); // Halt execution
  }
  Serial.println("LED array allocated successfully");
  
  FastLED.addLeds<LED_TYPE, PIN_LED_DATA, COLOR_ORDER>(leds, config_num_leds);
  FastLED.setBrightness((config_brightness_pct * 255) / 100);
  FastLED.clear();
  FastLED.show();
  Serial.println("FastLED initialized");
  
  // Test LEDs immediately
  Serial.println("Testing first few LEDs...");
  for(int i = 0; i < min(10, config_num_leds); i++) {
    leds[i] = CRGB::Red;
  }
  FastLED.show();
  delay(1000);
  FastLED.clear();
  FastLED.show();
  Serial.println("LED test complete");
  
  Serial.printf("Free heap after LED init: %d bytes\n", ESP.getFreeHeap());
  
  // Add watchdog feed
  delay(100);
  
  // Load data
  loadHighscores();
  loadColors();
  
  // RE-ENABLE AUDIO SYSTEM WITH DEBUGGING
  if (config_sound_on && ESP.getFreeHeap() > 20000) {
    Serial.println("Attempting to initialize audio system...");
    Serial.printf("Free heap before audio init: %d bytes\n", ESP.getFreeHeap());
    
    // Test I2S pins first
    Serial.printf("I2S pin configuration: BCLK=%d, LRC=%d, DOUT=%d, SD=%d\n", I2S_BCLK, I2S_LRC, I2S_DOUT, I2S_SD);
    
    audioQueue = xQueueCreate(10, sizeof(SoundEvent));
    
    if (audioQueue != nullptr) {
      Serial.println("Audio queue created successfully");
      
      // Load audio melodies
      Serial.println("Loading audio melodies...");
      melodyFromStr(melStart, cfg_snd_start);
      melodyFromStr(melWin, cfg_snd_win);
      melodyFromStr(melLose, cfg_snd_lose);
      melodyFromStr(melMistake, cfg_snd_mistake);
      melodyFromStr(melShotBlue, cfg_snd_shot_b);
      melodyFromStr(melShotRed, cfg_snd_shot_r);
      melodyFromStr(melShotGreen, cfg_snd_shot_g);
      melodyFromStr(melShotWhite, cfg_snd_shot_w);
      melodyFromStr(melHit, cfg_snd_hit);
      Serial.println("Audio melodies loaded");
      
      // Start audio task
      Serial.println("Creating audio task...");
      BaseType_t result = xTaskCreatePinnedToCore(audioTask, "AudioTask", 10240, NULL, 2, &audioTaskHandle, 0);
      if (result == pdPASS) {
        Serial.println("✓ Audio task created successfully");
        Serial.println("✓ Audio system fully initialized");
        
        // Test audio immediately
        Serial.println("Testing audio with startup sound...");
        delay(500); // Give task time to init
        playSound(EVT_START);
      } else {
        Serial.printf("✗ Failed to create audio task, error: %d\n", result);
        config_sound_on = false;
        audioQueue = nullptr;
      }
    } else {
      Serial.println("✗ ERROR: Failed to create audio queue");
      config_sound_on = false;
    }
    
    Serial.printf("Free heap after audio init: %d bytes\n", ESP.getFreeHeap());
  } else if (!config_sound_on) {
    Serial.println("Audio system disabled in configuration");
  } else {
    Serial.printf("✗ Not enough memory for audio (only %d bytes free)\n", ESP.getFreeHeap());
    config_sound_on = false;
  }
  
  // Initialize game state
  resetGame();
  currentState = STATE_MAIN_MENU;
  stateStartTime = millis();
  
  // Start WiFi for configuration
  WiFi.mode(WIFI_OFF);
  delay(100);
  
  Serial.printf("Final free heap: %d bytes\n", ESP.getFreeHeap());
  Serial.println("Setup complete - Game ready!");
}

void loop() {
  static unsigned long lastUpdate = 0;
  unsigned long now = millis();
  float deltaTime = (now - lastUpdate) / 1000.0f;
  lastUpdate = now;
  
  // Handle WiFi if enabled
  if (WiFi.getMode() != WIFI_OFF) {
    server.handleClient();
  }
  
  readButtons();
  
  // State machine
  switch(currentState) {
    case STATE_MAIN_MENU:
      if (btBlue || btRed || btGreen || btWhite) {
        resetGame();
        currentState = STATE_LEVEL_INTRO;
        stateStartTime = now;
        playSound(EVT_START);  // Game start sound
      }
      break;
      
    case STATE_LEVEL_INTRO:
      updateLevelIntro();
      break;
      
    case STATE_PLAYING: {
      // Color-matching shooting with debouncing - only RGB buttons (1-3)
      if (btBlue && !lastBtBlue) {
        if (shots.size() < 10) { // Limit shots
          shots.push_back({0.0, 1}); // Blue projectile (color index 1)
          playShotSound(1);  // Blue shot sound
        }
      }
      if (btRed && !lastBtRed) {
        if (shots.size() < 10) { // Limit shots
          shots.push_back({0.0, 2}); // Red projectile (color index 2)
          playShotSound(2);  // Red shot sound
        }
      }
      if (btGreen && !lastBtGreen) {
        if (shots.size() < 10) { // Limit shots
          shots.push_back({0.0, 3}); // Green projectile (color index 3)
          playShotSound(3);  // Green shot sound
        }
      }
      // White button reserved for mode switching only
      
      // Move shots
      for (int i = shots.size() - 1; i >= 0; i--) {
        shots[i].position += 100 * deltaTime;
        
        bool remove = false;
        if (shots[i].position >= config_num_leds) remove = true;
        
        // Check collision with enemies
        if (!remove) {
          if (shots[i].position >= enemyFrontIndex && !enemies.empty()) {
            // Hit enemy logic
            for (int e = enemies.size() - 1; e >= 0; e--) {
              if (enemies[e].active && abs(shots[i].position - enemies[e].position) < 1.0) {
                if (shots[i].color == enemies[e].color) {
                  currentScore += 10 * currentLevel;
                  enemies.erase(enemies.begin() + e);
                  remove = true;
                  playSound(EVT_HIT_SUCCESS);  // Successful hit sound
                  break;
                } else {
                  currentScore = max(0, currentScore - 5);
                  remove = true;
                  playSound(EVT_MISTAKE);  // Wrong color sound
                  break;
                }
              }
            }
          }
          
          // Check collision with boss projectiles
          for(int p=0; p<bossProjectiles.size(); p++) {
            if(abs(shots[i].position - bossProjectiles[p].position) < 1.0) {
              if(shots[i].color == bossProjectiles[p].color) {
                currentScore += 5;
                bossProjectiles.erase(bossProjectiles.begin() + p);
                remove = true;
                break;
              }
            }
          }
          
          // Check collision with boss segments  
          if (!remove && shots[i].position >= enemyFrontIndex && !bossSegments.empty()) {
            for (int b = bossSegments.size() - 1; b >= 0; b--) {
              if (bossSegments[b].active && abs(shots[i].position - bossSegments[b].position) < 5) {
                if (shots[i].color == bossSegments[b].color) {
                  currentScore += 20 * currentLevel;
                  bossSegments.erase(bossSegments.begin() + b);
                  remove = true;
                  // Audio event would go here if enabled
                  break;
                } else {
                  currentScore = max(0, currentScore - 10);
                  remove = true;
                  // Audio event would go here if enabled
                  break;
                }
              }
            }
          }
        }
        
        if (remove) {
          shots.erase(shots.begin() + i);
        }
      }

      // ENEMY MOVEMENT - Only start moving enemies 2 seconds after level begins
      if (millis() - levelStartTime > 2000) {
        // Move enemies towards player with proper speed progression
        float enemySpeed = 1.0 + (currentLevel * 0.8); // Slower progression for better playability
        float eStep = enemySpeed / 60.0; // Convert to step size (original formula)
        enemyFrontIndex -= eStep; 
        
        // Check if any active enemies have reached the player (not just enemyFrontIndex)
        bool gameOver = false;
        for (const auto& enemy : enemies) {
          if (enemy.active && enemy.position <= 5) { // Active enemy reached player area
            gameOver = true;
            break;
          }
        }
        
        if (gameOver) {
          // Trigger game over only when active enemies reach the player
          currentState = STATE_LOSE_SCREEN;
          stateStartTime = millis();
        }
        
        // Update all enemy positions relative to enemyFrontIndex
        for (auto& enemy : enemies) {
          enemy.position = enemyFrontIndex + enemy.originalIndex * 10;
        }
        
        // Move enemies
        for (auto& enemy : enemies) {
          enemy.position -= enemy.speed * deltaTime * 20;
        }
      }
      
      checkWinCondition();
      checkLoseCondition();
      break;
    }
      
    case STATE_BOSS_INTRO:
      updateBossIntro();
      break;
      
    case STATE_BOSS_PLAYING: {
      // Color-matching shooting with debouncing - only RGB buttons (1-3)
      if (btBlue && !lastBtBlue) {
        if (shots.size() < 10) { // Limit shots
          shots.push_back({0.0, 1}); // Blue projectile (color index 1)
          playShotSound(1);  // Blue shot sound
        }
      }
      if (btRed && !lastBtRed) {
        if (shots.size() < 10) { // Limit shots
          shots.push_back({0.0, 2}); // Red projectile (color index 2)
          playShotSound(2);  // Red shot sound
        }
      }
      if (btGreen && !lastBtGreen) {
        if (shots.size() < 10) { // Limit shots
          shots.push_back({0.0, 3}); // Green projectile (color index 3)
          playShotSound(3);  // Green shot sound
        }
      }
      // White button reserved for mode switching only
      
      // Move shots
      for (int i = shots.size() - 1; i >= 0; i--) {
        shots[i].position += 100 * deltaTime;
        
        bool remove = false;
        if (shots[i].position >= config_num_leds) remove = true;
        
        // Check collision with boss projectiles
        if (!remove) {
          for(int p=0; p<bossProjectiles.size(); p++) {
            if(abs(shots[i].position - bossProjectiles[p].position) < 1.0) {
              if(shots[i].color == bossProjectiles[p].color) {
                currentScore += 5;
                bossProjectiles.erase(bossProjectiles.begin() + p);
                remove = true;
                break;
              }
            }
          }
          
          // Check collision with boss segments  
          if (!remove && shots[i].position >= enemyFrontIndex && !bossSegments.empty()) {
            for (int b = bossSegments.size() - 1; b >= 0; b--) {
              if (bossSegments[b].active && abs(shots[i].position - bossSegments[b].position) < 5) {
                if (shots[i].color == bossSegments[b].color) {
                  currentScore += 20 * currentLevel;
                  bossSegments.erase(bossSegments.begin() + b);
                  remove = true;
                  // Audio event would go here if enabled
                  break;
                } else {
                  currentScore = max(0, currentScore - 10);
                  remove = true;
                  // Audio event would go here if enabled
                  break;
                }
              }
            }
          }
        }
        
        if (remove) {
          shots.erase(shots.begin() + i);
        }
      }
      
      // Boss behavior
      int bossNumber = currentLevel / 5;
      if (bossNumber == 1) {
        // Boss 1: Simple movement and shooting
        static unsigned long boss1Timer = 0;
        if (now - boss1Timer > 2000) {
          boss1Timer = now;
          bossProjectiles.push_back({enemyFrontIndex, (int)random(1,3)});
        }
        
        for (auto& seg : bossSegments) {
          seg.position -= boss1Cfg.speed * deltaTime * 20;
        }
      } else if (bossNumber == 2) {
        // Boss 2: Color lock and spray patterns
        if (boss2State == B2_CHARGE) {
          if (now - bossActionTimer < (boss2Cfg.shotFreq * 100)) {
            if (now % 100 < 20) boss2LockedColor = random(1,3);
          } else {
            boss2State = B2_SHOOT; boss2ShotsFired = 0; bossActionTimer = now;
            int startRange = 0; int endRange = 0;
            if (boss2Section == 0) { startRange=0; endRange=2; }
            else if (boss2Section == 1) { startRange=0; endRange=5; }
            else { startRange=0; endRange=8; }
            for(auto &seg : bossSegments) {
              if (seg.originalIndex >= startRange && seg.originalIndex <= endRange)
                seg.color = boss2LockedColor;
            }
          }
        } else if (boss2State == B2_SHOOT) {
          if (now - bossActionTimer > 150) {
            bossActionTimer = now;
            bossProjectiles.push_back({enemyFrontIndex, boss2LockedColor});
            boss2ShotsFired++;
            if (boss2ShotsFired >= 10) {
              int startRange = 0; int endRange = 0;
              if (boss2Section == 0) { startRange=0; endRange=2; }
              else if (boss2Section == 1) { startRange=3; endRange=5; }
              else { startRange=0; endRange=8; }
              for(auto &seg : bossSegments) {
                if (seg.originalIndex >= startRange && seg.originalIndex <= endRange)
                  seg.active = true;
              }
              boss2State = B2_MOVE; boss2Section++;
            }
          }
        }
      } else {
        // Boss 3: Spinning and random shooting
        if (boss3State == B3_SPIN) {
          if (now - boss3Timer > 500) {
            boss3Timer = now;
            for(auto &seg : bossSegments) seg.color = random(1, 4); // Only RGB colors
            boss3State = B3_SHOOT;
          }
        } else {
          if (now - boss3Timer > 200) {
            boss3Timer = now;
            bossProjectiles.push_back({enemyFrontIndex, (int)random(1,4)}); // Only RGB colors
            boss3State = B3_SPIN;
          }
        }
      }
      
      // BOSS MOVEMENT - Only start moving boss 2 seconds after level begins
      if (millis() - levelStartTime > 2000) {
        // Move boss towards player with proper speed progression
        float bossSpeed = 0.7 + (currentLevel * 0.4); // Even slower for boss levels
        float bStep = bossSpeed / 60.0; // Convert to step size (original formula)
        
        enemyFrontIndex -= bStep;
        
        // Check if any active boss segments have reached the player
        bool gameOver = false;
        for (const auto& seg : bossSegments) {
          if (seg.active && seg.position <= 5) { // Active boss segment reached player area
            gameOver = true;
            break;
          }
        }
        
        if (gameOver) {
          // Trigger game over only when active boss segments reach the player
          currentState = STATE_LOSE_SCREEN;
          stateStartTime = millis();
        }
        
        // Update all boss segment positions relative to enemyFrontIndex
        for (auto& seg : bossSegments) {
          seg.position = enemyFrontIndex + seg.originalIndex * 5;
        }
      }
      
      moveBossProjectiles(deltaTime);
      checkWinCondition();
      checkLoseCondition();
      break;
    }
      
    case STATE_WIN_SCREEN:
      if (now - stateStartTime > 4000) {
        currentLevel++;
        updateLevelPalette(); // Update palette for new level
        currentState = STATE_LEVEL_INTRO;
        stateStartTime = now;
      }
      break;
      
    case STATE_LOSE_SCREEN:
      if (now - stateStartTime > 4000) {
        currentState = STATE_MAIN_MENU;
        stateStartTime = now;
      }
      break;
  }
  
  // --------------------------------------------------------------------------
  // 8. RENDERING
  // --------------------------------------------------------------------------
  FastLED.clear();
  
  switch(currentState) {
    case STATE_MAIN_MENU:
      // Interactive gameplay preview to show this is a game
      {
        static unsigned long demoTimer = 0;
        static std::vector<Shot> demoShots;
        static std::vector<Enemy> demoEnemies;
        static int demoPhase = 0; // 0=setup, 1=gameplay, 2=boss preview
        
        // Demo phase cycling every 8 seconds
        if (now - attractModeTimer > 8000) {
          attractModeTimer = now;
          demoPhase = (demoPhase + 1) % 3;
          demoShots.clear();
          demoEnemies.clear();
        }
        
        if (demoPhase == 0) {
          // Setup phase - flowing rainbow to show LED capabilities
          for(int i = 0; i < config_num_leds; i++) {
            uint8_t wave = sin8(((i * 256 / config_num_leds) + (now / 8)) % 256);
            leds[i] = ColorFromPalette(RainbowColors_p, wave, 150, LINEARBLEND);
          }
          
          // "PRESS TO PLAY" indicator (center pulsing)
          int center = config_num_leds / 2;
          uint8_t brightness = beatsin8(15, 100, 255);
          for(int i = -5; i <= 5; i++) {
            if (center + i >= 0 && center + i < config_num_leds) {
              leds[center + i] = CRGB(brightness, brightness, brightness);
            }
          }
        }
        else if (demoPhase == 1) {
          // Regular gameplay preview
          FastLED.clear();
          
          // Create demo enemies if needed
          if (demoEnemies.empty()) {
            for (int i = 0; i < 5; i++) {
              Enemy enemy;
              enemy.position = config_num_leds - 10 + i * 15;
              enemy.color = random(1, 4);
              enemy.active = true;
              demoEnemies.push_back(enemy);
            }
          }
          
          // Move demo enemies
          for (auto& enemy : demoEnemies) {
            enemy.position -= 30 * deltaTime;
          }
          
          // Auto-fire demo shots
          if (now - demoTimer > 800) {
            demoTimer = now;
            if (demoShots.size() < 3) {
              demoShots.push_back({5.0, random(1, 4)});
            }
          }
          
          // Move demo shots and check collisions
          for (int i = demoShots.size() - 1; i >= 0; i--) {
            demoShots[i].position += 80 * deltaTime;
            
            // Remove shots that go too far
            if (demoShots[i].position >= config_num_leds) {
              demoShots.erase(demoShots.begin() + i);
              continue;
            }
            
            // Check demo collisions
            for (int e = demoEnemies.size() - 1; e >= 0; e--) {
              if (abs(demoShots[i].position - demoEnemies[e].position) < 1.0) {
                if (demoShots[i].color == demoEnemies[e].color) {
                  // Match! Create explosion effect
                  for (int ex = -3; ex <= 3; ex++) {
                    int exPos = (int)demoEnemies[e].position + ex;
                    if (exPos >= 0 && exPos < config_num_leds) {
                      leds[exPos] = CRGB::White;
                    }
                  }
                }
                demoEnemies.erase(demoEnemies.begin() + e);
                demoShots.erase(demoShots.begin() + i);
                break;
              }
            }
          }
          
          // Render demo elements
          for (const auto& enemy : demoEnemies) {
            if (enemy.position >= 0 && enemy.position < config_num_leds) {
              leds[(int)enemy.position] = getColor(enemy.color);
            }
          }
          
          for (const auto& shot : demoShots) {
            if (shot.position >= 0 && shot.position < config_num_leds) {
              leds[(int)shot.position] = getColor(shot.color);
            }
          }
          
          // Player indicator
          leds[5] = CRGB::White;
        }
        else {
          // Boss preview with dramatic effects
          for (int i = 0; i < config_num_leds; i++) {
            uint8_t noise = inoise8(i * 30, millis() / 8);
            leds[i] = ColorFromPalette(HeatColors_p, noise, 80, LINEARBLEND);
          }
          
          // Simulated boss segments
          int bossCenter = config_num_leds * 3 / 4;
          for (int i = -10; i <= 10; i += 3) {
            int pos = bossCenter + i;
            if (pos >= 0 && pos < config_num_leds) {
              uint8_t brightness = beatsin8(60, 150, 255);
              CRGB bossColor = getColor(((i/3) % 3) + 1);
              bossColor.nscale8(brightness);
              leds[pos] = bossColor;
            }
          }
          
          // Simulated boss projectiles
          if ((now / 300) % 2) {
            for (int proj = 20; proj < config_num_leds - 30; proj += 25) {
              leds[proj] = getColor(random(1, 4));
            }
          }
        }
      }
      break;
      
    case STATE_LEVEL_INTRO:
      // Spectacular level intro with rainbow wave
      {
        // Dynamic rainbow sweep
        for (int i = 0; i < config_num_leds; i++) {
          uint8_t wave = sin8(((i * 256 / config_num_leds) + (now / 6)) % 256);
          leds[i] = CHSV(wave, 255, 200);
        }
        
        // Level number display overlay with pulsing white indicators
        int levelStart = (config_num_leds / 2) - (currentLevel * 3);
        uint8_t levelBrightness = beatsin8(20, 150, 255);
        for (int i = 0; i < currentLevel && i < 10; i++) {
          int pos = levelStart + (i * 6);
          if (pos >= 0 && pos < config_num_leds) {
            // Bright level indicators
            for (int j = 0; j < 3; j++) {
              if (pos + j < config_num_leds && pos + j >= 0) {
                leds[pos + j] = CRGB(levelBrightness, levelBrightness, levelBrightness);
              }
            }
          }
        }
      }
      break;
      
    case STATE_PLAYING:
      // Render enemies with consistent base colors plus effects
      for(int i=0; i<enemies.size(); i++) {
        if (enemies[i].active && enemies[i].position >= 0 && enemies[i].position < config_num_leds) {
          int pos = (int)enemies[i].position;
          
          // Main enemy with pulsing brightness but consistent base color
          uint8_t brightness = beatsin8(60, 150, 255);
          CRGB baseColor = getColor(enemies[i].color);
          leds[pos] = baseColor;
          leds[pos].nscale8(brightness);
          
          // Menacing glow around enemy (dimmer but same color)
          for (int glow = -1; glow <= 1; glow++) {
            if (pos + glow >= 0 && pos + glow < config_num_leds && glow != 0) {
              CRGB glowColor = baseColor;
              glowColor.nscale8(50);
              leds[pos + glow] += glowColor;
            }
          }
        }
      }
      break;
      
    case STATE_BOSS_INTRO:
      // Boss intro animation
      for(int i=0; i<config_num_leds; i++) {
        if ((now/100 + i/5) % 2) leds[i] = cBoss;
      }
      break;
      
    case STATE_BOSS_PLAYING:
      {
        // Boss-specific background effects
        int bossNumber = currentLevel / 5;
        
        if (bossNumber == 1) {
          // Boss 1 - Fire Theme: Toned down heat simulation background
          static uint8_t heat[100];
          
          // Cool down every cell a little
          for (int i = 0; i < config_num_leds; i++) {
            heat[i] = qsub8(heat[i], random8(0, ((55 * 10) / config_num_leds) + 2));
          }
          
          // Heat from each cell drifts 'up' and diffuses a little
          for (int k = config_num_leds - 1; k >= 2; k--) {
            heat[k] = (heat[k - 1] + heat[k - 2] + heat[k - 2]) / 3;
          }
          
          // Randomly ignite new 'sparks'
          if (random8() < 120) {
            int sparkPos = random8(7);
            heat[sparkPos] = qadd8(heat[sparkPos], random8(160, 255));
          }
          
          // Map heat to LED colors with pulsing intensity to preserve visibility
          uint8_t backgroundIntensity = beatsin8(20, 30, 80); // Pulse between dim and moderate
          for (int j = 0; j < config_num_leds; j++) {
            CRGB heatColor = HeatColor(heat[j]);
            heatColor.nscale8(backgroundIntensity);
            leds[j] = heatColor;
          }
        }
        else if (bossNumber == 2) {
          // Boss 2 - Lightning/Electric Theme
          fadeToBlackBy(leds, config_num_leds, 30);
          
          // Random lightning strikes
          if (random8() < 30) {
            int strike = random16(config_num_leds);
            for (int i = -2; i <= 2; i++) {
              if (strike + i >= 0 && strike + i < config_num_leds) {
                leds[strike + i] = CRGB(255, 255, 255);
              }
            }
          }
          
          // Electric blue shimmer
          for (int i = 0; i < config_num_leds; i += 3) {
            if (beatsin8(40 + i, 0, 255) > 200) {
              leds[i] = CRGB(0, 100, 255);
            }
          }
        }
        else {
          // Boss 3+ - Psychedelic/Chaos Theme with controlled intensity
          uint8_t backgroundIntensity = beatsin8(25, 40, 100); // Pulsing background
          for (int i = 0; i < config_num_leds; i++) {
            uint8_t noise = inoise8(i * 50, millis() / 5);
            CRGB bgColor = ColorFromPalette(RainbowColors_p, noise, backgroundIntensity, LINEARBLEND);
            leds[i] = bgColor;
          }
          
          // Spinning color wheels with reduced intensity
          uint8_t spin = millis() / 20;
          for (int wheel = 0; wheel < 3; wheel++) {
            int center = wheel * (config_num_leds / 3);
            for (int i = 0; i < 10; i++) {
              int pos = center + i;
              if (pos < config_num_leds) {
                CRGB wheelColor = CHSV(spin + wheel * 85, 255, 150); // Reduced brightness
                leds[pos] += wheelColor;
              }
            }
          }
        }
        
        // Render boss segments with consistent base colors plus effects
        for(int i=0; i<bossSegments.size(); i++) {
          if (bossSegments[i].active && bossSegments[i].position >= 0 && bossSegments[i].position < config_num_leds) {
            int pos = (int)bossSegments[i].position;
            
            // Pulsing boss segments with consistent base color
            uint8_t bossBrightness = beatsin8(40, 200, 255);
            CRGB baseColor = getColor(bossSegments[i].color);
            leds[pos] = baseColor;
            leds[pos].nscale8(bossBrightness);
            
            // Boss segment glow (same color, varying brightness by distance)
            for (int glow = -2; glow <= 2; glow++) {
              if (pos + glow >= 0 && pos + glow < config_num_leds && glow != 0) {
                CRGB glowColor = baseColor;
                glowColor.nscale8(80 - abs(glow * 30));
                leds[pos + glow] += glowColor;
              }
            }
          }
        }
        
        // Render boss projectiles with consistent base colors plus trails
        for(auto &p : bossProjectiles) {
          if (p.position >= 0 && p.position < config_num_leds) {
            int pos = (int)p.position;
            CRGB baseColor = getColor(p.color);
            leds[pos] = baseColor;
            
            // Projectile trail with same color
            if (pos - 1 >= 0) {
              CRGB trailColor = baseColor;
              trailColor.nscale8(100);
              leds[pos - 1] += trailColor;
            }
          }
        }
      }
      break;
      
    case STATE_WIN_SCREEN:
      // Victory fireworks spectacular!
      {
        // Fade background for sparkle effect
        fadeToBlackBy(leds, config_num_leds, 20);
        
        // Multiple burst points with expanding rings
        for (int burst = 0; burst < 3; burst++) {
          int center = (burst + 1) * (config_num_leds / 4);
          int radius = beatsin8(30 + burst * 10, 5, 15);
          
          for (int i = -radius; i <= radius; i++) {
            int pos = center + i;
            if (pos >= 0 && pos < config_num_leds) {
              uint8_t brightness = 255 - abs(i * 15);
              leds[pos] += CHSV(gHue + burst * 80, 255, brightness);
            }
          }
        }
        
        // Victory sparkles rain
        for (int i = 0; i < 5; i++) {
          if (random8() < 80) {
            leds[random16(config_num_leds)] += CRGB::White;
          }
        }
        
        // Center victory blast
        int center = config_num_leds / 2;
        uint8_t victoryPulse = beatsin8(25, 100, 255);
        for (int i = -8; i <= 8; i++) {
          if (center + i >= 0 && center + i < config_num_leds) {
            leds[center + i] += CHSV(gHue, 200, victoryPulse - abs(i * 20));
          }
        }
      }
      break;
      
    case STATE_LOSE_SCREEN:
      // Game over animation
      for(int i=0; i<config_num_leds; i++) {
        if ((now/100) % 2) leds[i] = c2;
      }
      break;
  }
  
  // Render shots as single precise pixels
  for(auto &s : shots) {
    if (s.position >= 0 && s.position < config_num_leds) {
      // Single pixel shot for precise targeting
      CRGB baseColor = getColor(s.color);
      leds[(int)s.position] = baseColor;
    }
  }

  // Update global effects
  EVERY_N_MILLISECONDS(20) { gHue++; } // Rainbow cycling
  
  // Render player
  if (playerPosition >= 0 && playerPosition < config_num_leds) {
    leds[playerPosition] = CRGB::White;
  }
  
  FastLED.show();
  
  // Feed watchdog to prevent boot loops
  delay(1);
}