// 1D RGB LED Strip Space Invaders Game for ESP32
// Optimized for new Elegoo ESP32-WROOM 32 board
// Audio features disabled for stability

#include <Arduino.h>
#include <FastLED.h>
#include <Preferences.h>
#include <WiFi.h>
#include <WebServer.h>

// --------------------------------------------------------------------------
// 1. HARDWARE CONFIGURATION
// --------------------------------------------------------------------------
#define PIN_LED_DATA    23  // MOSI pin - optimal for WS2812B on ESP32
#define MAX_LEDS        1200 
#define LED_TYPE        WS2812B
#define COLOR_ORDER     GRB

// Button pins
#define PIN_BUTTON_BLUE  15
#define PIN_BUTTON_RED   19  
#define PIN_BUTTON_GREEN 17
#define PIN_BUTTON_WHITE 18

// --------------------------------------------------------------------------
// 2. GAME DATA STRUCTURES
// --------------------------------------------------------------------------
struct Shot {
  float position;
  int color;
};

struct Enemy {
  float position;
  int color;
  bool active;
  float speed;
  int originalIndex;
};

struct BossSegment {
  float position;
  int color;
  bool active;
  int originalIndex;
};

struct BossProjectile {
  float position;
  int color;
};

struct BossConfig {
  int numSegments;
  float speed;
  float shotFreq;
  int hits;
};

// --------------------------------------------------------------------------
// 3. GLOBAL VARIABLES
// --------------------------------------------------------------------------

// LED strip
CRGB* leds;
int config_num_leds = 100;  // Increased from 60 for longer gameplay
int config_brightness_pct = 50;  // Reduced brightness

// Game state
enum GameState {
  STATE_MAIN_MENU,
  STATE_LEVEL_INTRO,
  STATE_PLAYING,
  STATE_BOSS_INTRO,
  STATE_BOSS_PLAYING,
  STATE_WIN_SCREEN,
  STATE_LOSE_SCREEN
};

GameState currentState = STATE_MAIN_MENU;
unsigned long stateStartTime = 0;

// Player and game mechanics
int playerPosition = 0;
int currentLevel = 1;
int config_start_level = 1;
int currentScore = 0;
int livesRemaining = 3;
bool won = false;
bool btBlue = false, btRed = false, btGreen = false, btWhite = false;
bool lastBtBlue = false, lastBtRed = false, lastBtGreen = false, lastBtWhite = false;
unsigned long lastButtonCheck = 0;
float enemyFrontIndex = 0;
unsigned long levelStartTime = 0;

// Collections for game objects
std::vector<Shot> shots;
std::vector<Enemy> enemies;
std::vector<BossSegment> bossSegments;
std::vector<BossProjectile> bossProjectiles;

// High scores
int highScores[5] = {0, 0, 0, 0, 0};

// Visual Effects System
CRGBPalette16 currentPalette = RainbowColors_p;
TBlendType currentBlending = LINEARBLEND;
uint8_t gHue = 0; // Global hue for effects
uint8_t attractModeStep = 0;
unsigned long attractModeTimer = 0;

// Colors (customizable via web interface)
CRGB c1 = CRGB::Blue;
CRGB c2 = CRGB::Red;
CRGB c3 = CRGB::Green;
CRGB c4 = CRGB::White;
CRGB c5 = CRGB::Yellow;
CRGB c6 = CRGB::Purple;
CRGB cWall = CRGB::Orange;
CRGB cBoss = CRGB::Purple;

// Web server configuration
String config_ssid = "1DEnviroGame";
String config_pass = "password123";
String config_ip = "192.168.4.1";
String config_gateway = "192.168.4.1";
String config_subnet = "255.255.255.0";
String config_dns = "192.168.4.1";
bool config_static_ip = false;
String currentProfilePrefix = "default";

// Boss fight variables
BossConfig boss1Cfg = {20, 0.3, 2.0, 15};
BossConfig boss2Cfg = {30, 0.5, 1.5, 25};
BossConfig boss3Cfg = {40, 0.7, 1.0, 35};

enum Boss2State { B2_CHARGE, B2_SHOOT, B2_MOVE };
Boss2State boss2State = B2_CHARGE;
int boss2LockedColor = 1;
int boss2ShotsFired = 0;
int boss2Section = 0;
unsigned long bossActionTimer = 0;

enum Boss3State { B3_SPIN, B3_SHOOT };
Boss3State boss3State = B3_SPIN;
unsigned long boss3Timer = 0;

// Preferences and WiFi
Preferences preferences;
WebServer server(80);

// --------------------------------------------------------------------------
// 4. AUDIO SYSTEM (DISABLED)
// --------------------------------------------------------------------------
// Audio functionality completely removed for stability

// --------------------------------------------------------------------------
// 5. BUTTON HANDLING
// --------------------------------------------------------------------------
void readButtons() {
  if (millis() - lastButtonCheck > 50) { // Debounce
    lastButtonCheck = millis();
    
    // Store previous button states for debouncing
    lastBtBlue = btBlue;
    lastBtRed = btRed;
    lastBtGreen = btGreen;
    lastBtWhite = btWhite;
    
    // Read current button states
    btBlue = !digitalRead(PIN_BUTTON_BLUE);
    btRed = !digitalRead(PIN_BUTTON_RED);
    btGreen = !digitalRead(PIN_BUTTON_GREEN);
    btWhite = !digitalRead(PIN_BUTTON_WHITE);
  }
}

// --------------------------------------------------------------------------
// 6. GAME LOGIC FUNCTIONS  
// --------------------------------------------------------------------------
void saveHighscores() {
  preferences.begin("game", false);
  for (int i = 0; i < 5; i++) {
    String key = "hs" + String(i);
    preferences.putInt(key.c_str(), highScores[i]);
  }
  preferences.end();
}

void loadHighscores() {
  preferences.begin("game", true);
  for (int i = 0; i < 5; i++) {
    String key = "hs" + String(i);
    highScores[i] = preferences.getInt(key.c_str(), 0);
  }
  preferences.end();
}

bool addHighScore(int score) {
  bool newRecord = false;
  for (int i = 0; i < 5; i++) {
    if (score > highScores[i]) {
      // Shift scores down
      for (int j = 4; j > i; j--) {
        highScores[j] = highScores[j-1];
      }
      highScores[i] = score;
      newRecord = true;
      break;
    }
  }
  if (newRecord) saveHighscores();
  return newRecord;
}

void resetGame() {
  currentLevel = config_start_level;
  currentScore = 0;
  livesRemaining = 3;
  won = false;
  playerPosition = 0;
  enemyFrontIndex = config_num_leds - 1;
  updateLevelPalette(); // Set palette for starting level
  
  shots.clear();
  enemies.clear();
  bossSegments.clear();
  bossProjectiles.clear();
}

void checkWinCondition() {
  won = false;
  if (currentState == STATE_PLAYING && enemies.empty()) won = true;
  if (currentState == STATE_BOSS_PLAYING && bossSegments.empty()) won = true;
  
  if (won) {
    // Clear all game entities immediately when entering victory state
    enemies.clear();
    shots.clear(); 
    bossProjectiles.clear();
    bossSegments.clear();
    
    addHighScore(currentScore);
    currentState = STATE_WIN_SCREEN;
    stateStartTime = millis();
    // Audio event would go here if enabled
  }
}

void checkLoseCondition() {
  // Check if enemies reached player
  bool enemyReachedPlayer = false;
  for (const auto& enemy : enemies) {
    if (enemy.position <= 0) {
      enemyReachedPlayer = true;
      break;
    }
  }
  
  // Check boss projectiles hit player  
  for (const auto& proj : bossProjectiles) {
    if (proj.position <= 0) {
      enemyReachedPlayer = true;
      break;
    }
  }
  
  if (enemyReachedPlayer) {
    livesRemaining--;
    if (livesRemaining <= 0) {
      addHighScore(currentScore);
      currentState = STATE_LOSE_SCREEN;
      stateStartTime = millis();
      // Audio event would go here if enabled
    } else {
      // Reset positions for new life
      shots.clear();
      bossProjectiles.clear();
      enemyFrontIndex = config_num_leds - 1;
      for (auto& enemy : enemies) {
        enemy.position = enemyFrontIndex + enemy.originalIndex * 10;
      }
    }
  }
}

void spawnEnemies() {
  enemies.clear();
  enemyFrontIndex = config_num_leds - 1; // Reset enemy front position to start of strip
  int numEnemies = 5 + currentLevel * 2;
  if (numEnemies > 20) numEnemies = 20;
  
  for (int i = 0; i < numEnemies; i++) {
    Enemy enemy;
    enemy.position = enemyFrontIndex + i * 10;
    enemy.color = (i % 3) + 1; // Only use colors 1-3 (RGB)
    enemy.active = true;
    enemy.speed = 0.2 + currentLevel * 0.1;
    enemy.originalIndex = i;
    enemies.push_back(enemy);
  }
}

void updateLevelIntro() {
  if (millis() - stateStartTime > 3000) {
    if (currentLevel % 5 == 0) {
      // Boss level
      bossSegments.clear(); enemies.clear(); shots.clear(); bossProjectiles.clear();
      currentState = STATE_BOSS_INTRO;
      stateStartTime = millis();
    } else {
      // Regular level
      enemies.clear(); shots.clear(); bossProjectiles.clear();
      spawnEnemies();
      currentState = STATE_PLAYING;
      levelStartTime = millis();
    }
  }
}

void spawnBoss() {
  bossSegments.clear();
  enemyFrontIndex = config_num_leds - 1; // Reset boss front position to start of strip
  BossConfig cfg;
  int bossNumber = currentLevel / 5;
  
  switch(bossNumber) {
    case 1: cfg = boss1Cfg; break;
    case 2: cfg = boss2Cfg; break;
    default: cfg = boss3Cfg; break;
  }
  
  for (int i = 0; i < cfg.numSegments; i++) {
    BossSegment seg;
    seg.position = enemyFrontIndex + i * 5;
    seg.color = (i % 3) + 1; // Only use colors 1-3 (RGB)
    seg.active = true;
    seg.originalIndex = i;
    bossSegments.push_back(seg);
  }
  
  boss2State = B2_CHARGE;
  boss3State = B3_SPIN;
  boss2Section = 0;
  bossActionTimer = millis();
}

void updateBossIntro() {
  if (millis() - stateStartTime > 3000) {
    spawnBoss();
    currentState = STATE_BOSS_PLAYING;
    levelStartTime = millis();  // Set level start time for boss levels
    stateStartTime = millis();
  }
}

void moveBossProjectiles(float deltaTime) {
  for(int i=bossProjectiles.size()-1; i>=0; i--) {
    bossProjectiles[i].position -= 50 * deltaTime;
    if (bossProjectiles[i].position < 0) {
      bossProjectiles.erase(bossProjectiles.begin() + i);
    }
  }
}

void loadColors() {
  preferences.begin("colors", true);
  // Load hex color strings and convert to CRGB
  String hex_c1 = preferences.getString("c1", "0000FF");
  String hex_c2 = preferences.getString("c2", "FF0000"); 
  String hex_c3 = preferences.getString("c3", "00FF00");
  String hex_c4 = preferences.getString("c4", "FFFFFF");
  String hex_c5 = preferences.getString("c5", "FFFF00");
  String hex_c6 = preferences.getString("c6", "FF00FF");
  String hex_cw = preferences.getString("cw", "FFA500");
  String hex_cb = preferences.getString("cb", "800080");
  
  c1 = CRGB(strtol(hex_c1.c_str(), NULL, 16));
  c2 = CRGB(strtol(hex_c2.c_str(), NULL, 16));
  c3 = CRGB(strtol(hex_c3.c_str(), NULL, 16));
  c4 = CRGB(strtol(hex_c4.c_str(), NULL, 16));
  c5 = CRGB(strtol(hex_c5.c_str(), NULL, 16));
  c6 = CRGB(strtol(hex_c6.c_str(), NULL, 16));
  cWall = CRGB(strtol(hex_cw.c_str(), NULL, 16));
  cBoss = CRGB(strtol(hex_cb.c_str(), NULL, 16));
  
  preferences.end();
}

void handleSaveColors() {
  String hex_c1, hex_c2, hex_c3, hex_c4, hex_c5, hex_c6, hex_cw, hex_cb;
  
  if(server.hasArg("c1")) hex_c1 = server.arg("c1");
  if(server.hasArg("c2")) hex_c2 = server.arg("c2");
  if(server.hasArg("c3")) hex_c3 = server.arg("c3");
  if(server.hasArg("c4")) hex_c4 = server.arg("c4");
  if(server.hasArg("c5")) hex_c5 = server.arg("c5");
  if(server.hasArg("c6")) hex_c6 = server.arg("c6");
  if(server.hasArg("cw")) hex_cw = server.arg("cw");
  if(server.hasArg("cb")) hex_cb = server.arg("cb");
  
  preferences.begin("colors", false);
  preferences.putString("c1", hex_c1);
  preferences.putString("c2", hex_c2);
  preferences.putString("c3", hex_c3);
  preferences.putString("c4", hex_c4);
  preferences.putString("c5", hex_c5);
  preferences.putString("c6", hex_c6);
  preferences.putString("cw", hex_cw);
  preferences.putString("cb", hex_cb);
  preferences.end();
  
  loadColors();
  
  server.sendHeader("Location", "/colors");
  server.send(303);
}

// Audio configuration functions removed - no longer needed

void saveCurrentToPreferences(String prefix) {
  preferences.begin("game", false);
  preferences.putInt((prefix + "_num_leds").c_str(), config_num_leds);
  preferences.putInt((prefix + "_brightness").c_str(), config_brightness_pct);
  preferences.putInt((prefix + "_start_level").c_str(), config_start_level);
  preferences.putString((prefix + "_ssid").c_str(), config_ssid);
  preferences.putString((prefix + "_pass").c_str(), config_pass);
  preferences.putString((prefix + "_ip").c_str(), config_ip);
  preferences.putString((prefix + "_gateway").c_str(), config_gateway);
  preferences.putString((prefix + "_subnet").c_str(), config_subnet);
  preferences.putString((prefix + "_dns").c_str(), config_dns);
  preferences.putBool((prefix + "_static_ip").c_str(), config_static_ip);
  preferences.end();
}

void performFactoryReset() {
  preferences.begin("game", true);
  preferences.clear();
  preferences.end();
  preferences.begin("colors", true);
  preferences.clear();
  preferences.end();
  preferences.begin("snds", true);
  preferences.clear();
  preferences.end();
  
  // Reset to defaults - reduced for stability
  config_num_leds = 100;
  config_brightness_pct = 50;
  config_start_level = 1;
  config_ssid = "1DEnviroGame";
  config_pass = "password123";
  for (int i = 0; i < 5; i++) highScores[i] = 0;
  loadColors();
}

void loadConfig(String prefix) {
  preferences.begin("game", true);
  config_num_leds = preferences.getInt((prefix + "_num_leds").c_str(), 100);  // Increased default
  config_brightness_pct = preferences.getInt((prefix + "_brightness").c_str(), 50);  // Reduced default
  config_start_level = preferences.getInt((prefix + "_start_level").c_str(), 1);
  config_ssid = preferences.getString((prefix + "_ssid").c_str(), "1DEnviroGame");
  config_pass = preferences.getString((prefix + "_pass").c_str(), "password123");
  config_ip = preferences.getString((prefix + "_ip").c_str(), "192.168.4.1");
  config_gateway = preferences.getString((prefix + "_gateway").c_str(), "192.168.4.1");
  config_subnet = preferences.getString((prefix + "_subnet").c_str(), "255.255.255.0");
  config_dns = preferences.getString((prefix + "_dns").c_str(), "192.168.4.1");
  config_static_ip = preferences.getBool((prefix + "_static_ip").c_str(), false);
  currentProfilePrefix = prefix;
  preferences.end();
}

void handleProfileSwitch() {
  if (server.hasArg("profile")) {
    String newProfile = server.arg("profile");
    saveCurrentToPreferences(currentProfilePrefix);
    preferences.begin("game", false); preferences.putString("act_prof", currentProfilePrefix); preferences.end();
    loadConfig(newProfile);
  }
  server.sendHeader("Location", "/");
  server.send(303);
}

void handleReset() { performFactoryReset(); server.send(200, "text/html", "<h2>Reset successful!</h2><p>Values & Scores wiped. ESP restarting.</p>"); delay(1000); ESP.restart(); }

void handleSave() {
  if (server.hasArg("leds")) config_num_leds = server.arg("leds").toInt(); if (server.hasArg("bright")) config_brightness_pct = server.arg("bright").toInt(); if (server.hasArg("startlvl")) config_start_level = server.arg("startlvl").toInt();
  if (server.hasArg("ssid")) config_ssid = server.arg("ssid"); if (server.hasArg("pass")) config_pass = server.arg("pass");
  config_static_ip = server.hasArg("static_ip"); config_ip = server.arg("ip"); config_gateway = server.arg("gw"); config_subnet = server.arg("sn"); config_dns = server.arg("dns");
  
  // Reallocate LED array if size changed
  if (leds) delete[] leds;
  leds = new CRGB[config_num_leds];
  FastLED.addLeds<LED_TYPE, PIN_LED_DATA, COLOR_ORDER>(leds, config_num_leds);
  FastLED.setBrightness((config_brightness_pct * 255) / 100);
  
  preferences.begin("game", false);
  preferences.putInt("num_leds", config_num_leds);
  preferences.putInt("brightness", config_brightness_pct);
  preferences.putInt("start_level", config_start_level);
  preferences.putString("ssid", config_ssid);
  preferences.putString("pass", config_pass);
  preferences.putString("ip", config_ip);
  preferences.putString("gateway", config_gateway);
  preferences.putString("subnet", config_subnet);
  preferences.putString("dns", config_dns);
  preferences.putBool("static_ip", config_static_ip);
  preferences.end();
  
  server.sendHeader("Location", "/");
  server.send(303);
}

CRGB getColor(int colorIndex) {
  switch(colorIndex) {
    case 1: return c1;
    case 2: return c2;
    case 3: return c3;
    case 4: return c4;
    case 5: return c5;
    case 6: return c6;
    case 7: return cWall;
    case 8: return cBoss;
    default: return CRGB::Black;
  }
}

// Enhanced color system with palettes
void updateLevelPalette() {
  if (currentLevel <= 3) currentPalette = PartyColors_p;
  else if (currentLevel <= 7) currentPalette = HeatColors_p; 
  else if (currentLevel <= 12) currentPalette = OceanColors_p;
  else currentPalette = LavaColors_p;
}

CRGB getEnhancedColor(int colorIndex) {
  uint8_t paletteIndex = map(colorIndex, 1, 3, 0, 240);
  return ColorFromPalette(currentPalette, paletteIndex + gHue, 255, currentBlending);
}

uint8_t breathingBrightness() {
  return beatsin8(12, 80, 255); // Slow breathing effect
}

void enableWiFi() {
  WiFi.mode(WIFI_AP_STA);
  WiFi.softAP(config_ssid.c_str(), config_pass.c_str());
  
  if (config_static_ip) {
    IPAddress ip, gateway, subnet, dns;
    ip.fromString(config_ip);
    gateway.fromString(config_gateway);
    subnet.fromString(config_subnet);
    dns.fromString(config_dns);
    WiFi.softAPConfig(ip, gateway, subnet);
  }
  
  server.begin();
  Serial.print("WiFi AP started: ");
  Serial.println(WiFi.softAPIP());
}

// --------------------------------------------------------------------------
// 7. MAIN SETUP AND LOOP
// --------------------------------------------------------------------------

void setup() {
  Serial.begin(115200);
  delay(1000);
  Serial.println("1D RGB Invader Game - Starting...");
  
  // Initialize buttons with pullups
  pinMode(PIN_BUTTON_BLUE, INPUT_PULLUP);
  pinMode(PIN_BUTTON_RED, INPUT_PULLUP);
  pinMode(PIN_BUTTON_GREEN, INPUT_PULLUP);
  pinMode(PIN_BUTTON_WHITE, INPUT_PULLUP);
  
  // Load configuration
  preferences.begin("game", true);
  config_num_leds = preferences.getInt("num_leds", 100);  // Updated default to 100
  config_brightness_pct = preferences.getInt("brightness", 50);  // Reduced default
  config_start_level = preferences.getInt("start_level", 1);
  config_ssid = preferences.getString("ssid", "1DEnviroGame");
  config_pass = preferences.getString("pass", "password123");
  config_ip = preferences.getString("ip", "192.168.4.1");
  config_gateway = preferences.getString("gateway", "192.168.4.1");
  config_subnet = preferences.getString("subnet", "255.255.255.0");
  config_dns = preferences.getString("dns", "192.168.4.1");
  config_static_ip = preferences.getBool("static_ip", false);
  currentProfilePrefix = preferences.getString("act_prof", "default");
  preferences.end();
  
  // Initialize LED strip
  leds = new CRGB[config_num_leds];
  FastLED.addLeds<LED_TYPE, PIN_LED_DATA, COLOR_ORDER>(leds, config_num_leds);
  FastLED.setBrightness((config_brightness_pct * 255) / 100);
  FastLED.clear();
  FastLED.show();
  
  // Add watchdog feed
  delay(100);
  
  // Load data
  loadHighscores();
  loadColors();
  
  // Initialize game state
  resetGame();
  currentState = STATE_MAIN_MENU;
  stateStartTime = millis();
  
  // Start WiFi for configuration
  WiFi.mode(WIFI_OFF);
  delay(100);
  
  Serial.println("Setup complete - Game ready!");
}

void loop() {
  static unsigned long lastUpdate = 0;
  unsigned long now = millis();
  float deltaTime = (now - lastUpdate) / 1000.0f;
  lastUpdate = now;
  
  // Handle WiFi if enabled
  if (WiFi.getMode() != WIFI_OFF) {
    server.handleClient();
  }
  
  readButtons();
  
  // State machine
  switch(currentState) {
    case STATE_MAIN_MENU:
      if (btBlue || btRed || btGreen || btWhite) {
        resetGame();
        currentState = STATE_LEVEL_INTRO;
        stateStartTime = now;
        // Audio event would go here if enabled
      }
      break;
      
    case STATE_LEVEL_INTRO:
      updateLevelIntro();
      break;
      
    case STATE_PLAYING: {
      // Color-matching shooting with debouncing - only RGB buttons (1-3)
      if (btBlue && !lastBtBlue) {
        if (shots.size() < 10) { // Limit shots
          shots.push_back({0.0, 1}); // Blue projectile (color index 1)
          // Audio event would go here if enabled
        }
      }
      if (btRed && !lastBtRed) {
        if (shots.size() < 10) { // Limit shots
          shots.push_back({0.0, 2}); // Red projectile (color index 2)
          // Audio event would go here if enabled
        }
      }
      if (btGreen && !lastBtGreen) {
        if (shots.size() < 10) { // Limit shots
          shots.push_back({0.0, 3}); // Green projectile (color index 3)
          // Audio event would go here if enabled
        }
      }
      // White button reserved for mode switching only
      
      // Move shots
      for (int i = shots.size() - 1; i >= 0; i--) {
        shots[i].position += 100 * deltaTime;
        
        bool remove = false;
        if (shots[i].position >= config_num_leds) remove = true;
        
        // Check collision with enemies
        if (!remove) {
          if (shots[i].position >= enemyFrontIndex && !enemies.empty()) {
            // Hit enemy logic
            for (int e = enemies.size() - 1; e >= 0; e--) {
              if (enemies[e].active && abs(shots[i].position - enemies[e].position) < 5) {
                if (shots[i].color == enemies[e].color) {
                  currentScore += 10 * currentLevel;
                  enemies.erase(enemies.begin() + e);
                  remove = true;
                  // Audio event would go here if enabled
                  break;
                } else {
                  currentScore = max(0, currentScore - 5);
                  remove = true;
                  // Audio event would go here if enabled
                  break;
                }
              }
            }
          }
          
          // Check collision with boss projectiles
          for(int p=0; p<bossProjectiles.size(); p++) {
            if(abs(shots[i].position - bossProjectiles[p].position) < 3) {
              if(shots[i].color == bossProjectiles[p].color) {
                currentScore += 5;
                bossProjectiles.erase(bossProjectiles.begin() + p);
                remove = true;
                break;
              }
            }
          }
          
          // Check collision with boss segments  
          if (!remove && shots[i].position >= enemyFrontIndex && !bossSegments.empty()) {
            for (int b = bossSegments.size() - 1; b >= 0; b--) {
              if (bossSegments[b].active && abs(shots[i].position - bossSegments[b].position) < 5) {
                if (shots[i].color == bossSegments[b].color) {
                  currentScore += 20 * currentLevel;
                  bossSegments.erase(bossSegments.begin() + b);
                  remove = true;
                  // Audio event would go here if enabled
                  break;
                } else {
                  currentScore = max(0, currentScore - 10);
                  remove = true;
                  // Audio event would go here if enabled
                  break;
                }
              }
            }
          }
        }
        
        if (remove) {
          shots.erase(shots.begin() + i);
        }
      }

      // ENEMY MOVEMENT - Only start moving enemies 2 seconds after level begins
      if (millis() - levelStartTime > 2000) {
        // Move enemies towards player with proper speed progression
        float enemySpeed = 1.0 + (currentLevel * 0.8); // Slower progression for better playability
        float eStep = enemySpeed / 60.0; // Convert to step size (original formula)
        enemyFrontIndex -= eStep; 
        
        // Check if any active enemies have reached the player (not just enemyFrontIndex)
        bool gameOver = false;
        for (const auto& enemy : enemies) {
          if (enemy.active && enemy.position <= 5) { // Active enemy reached player area
            gameOver = true;
            break;
          }
        }
        
        if (gameOver) {
          // Trigger game over only when active enemies reach the player
          currentState = STATE_LOSE_SCREEN;
          stateStartTime = millis();
        }
        
        // Update all enemy positions relative to enemyFrontIndex
        for (auto& enemy : enemies) {
          enemy.position = enemyFrontIndex + enemy.originalIndex * 10;
        }
        
        // Move enemies
        for (auto& enemy : enemies) {
          enemy.position -= enemy.speed * deltaTime * 20;
        }
      }
      
      checkWinCondition();
      checkLoseCondition();
      break;
    }
      
    case STATE_BOSS_INTRO:
      updateBossIntro();
      break;
      
    case STATE_BOSS_PLAYING: {
      // Color-matching shooting with debouncing - only RGB buttons (1-3)
      if (btBlue && !lastBtBlue) {
        if (shots.size() < 10) { // Limit shots
          shots.push_back({0.0, 1}); // Blue projectile (color index 1)
        }
      }
      if (btRed && !lastBtRed) {
        if (shots.size() < 10) { // Limit shots
          shots.push_back({0.0, 2}); // Red projectile (color index 2)
        }
      }
      if (btGreen && !lastBtGreen) {
        if (shots.size() < 10) { // Limit shots
          shots.push_back({0.0, 3}); // Green projectile (color index 3)
        }
      }
      // White button reserved for mode switching only
      
      // Move shots
      for (int i = shots.size() - 1; i >= 0; i--) {
        shots[i].position += 100 * deltaTime;
        
        bool remove = false;
        if (shots[i].position >= config_num_leds) remove = true;
        
        // Check collision with boss projectiles
        if (!remove) {
          for(int p=0; p<bossProjectiles.size(); p++) {
            if(abs(shots[i].position - bossProjectiles[p].position) < 3) {
              if(shots[i].color == bossProjectiles[p].color) {
                currentScore += 5;
                bossProjectiles.erase(bossProjectiles.begin() + p);
                remove = true;
                break;
              }
            }
          }
          
          // Check collision with boss segments  
          if (!remove && shots[i].position >= enemyFrontIndex && !bossSegments.empty()) {
            for (int b = bossSegments.size() - 1; b >= 0; b--) {
              if (bossSegments[b].active && abs(shots[i].position - bossSegments[b].position) < 5) {
                if (shots[i].color == bossSegments[b].color) {
                  currentScore += 20 * currentLevel;
                  bossSegments.erase(bossSegments.begin() + b);
                  remove = true;
                  // Audio event would go here if enabled
                  break;
                } else {
                  currentScore = max(0, currentScore - 10);
                  remove = true;
                  // Audio event would go here if enabled
                  break;
                }
              }
            }
          }
        }
        
        if (remove) {
          shots.erase(shots.begin() + i);
        }
      }
      
      // Boss behavior
      int bossNumber = currentLevel / 5;
      if (bossNumber == 1) {
        // Boss 1: Simple movement and shooting
        static unsigned long boss1Timer = 0;
        if (now - boss1Timer > 2000) {
          boss1Timer = now;
          bossProjectiles.push_back({enemyFrontIndex, (int)random(1,3)});
        }
        
        for (auto& seg : bossSegments) {
          seg.position -= boss1Cfg.speed * deltaTime * 20;
        }
      } else if (bossNumber == 2) {
        // Boss 2: Color lock and spray patterns
        if (boss2State == B2_CHARGE) {
          if (now - bossActionTimer < (boss2Cfg.shotFreq * 100)) {
            if (now % 100 < 20) boss2LockedColor = random(1,3);
          } else {
            boss2State = B2_SHOOT; boss2ShotsFired = 0; bossActionTimer = now;
            int startRange = 0; int endRange = 0;
            if (boss2Section == 0) { startRange=0; endRange=2; }
            else if (boss2Section == 1) { startRange=0; endRange=5; }
            else { startRange=0; endRange=8; }
            for(auto &seg : bossSegments) {
              if (seg.originalIndex >= startRange && seg.originalIndex <= endRange)
                seg.color = boss2LockedColor;
            }
          }
        } else if (boss2State == B2_SHOOT) {
          if (now - bossActionTimer > 150) {
            bossActionTimer = now;
            bossProjectiles.push_back({enemyFrontIndex, boss2LockedColor});
            boss2ShotsFired++;
            if (boss2ShotsFired >= 10) {
              int startRange = 0; int endRange = 0;
              if (boss2Section == 0) { startRange=0; endRange=2; }
              else if (boss2Section == 1) { startRange=3; endRange=5; }
              else { startRange=0; endRange=8; }
              for(auto &seg : bossSegments) {
                if (seg.originalIndex >= startRange && seg.originalIndex <= endRange)
                  seg.active = true;
              }
              boss2State = B2_MOVE; boss2Section++;
            }
          }
        }
      } else {
        // Boss 3: Spinning and random shooting
        if (boss3State == B3_SPIN) {
          if (now - boss3Timer > 500) {
            boss3Timer = now;
            for(auto &seg : bossSegments) seg.color = random(1, 4); // Only RGB colors
            boss3State = B3_SHOOT;
          }
        } else {
          if (now - boss3Timer > 200) {
            boss3Timer = now;
            bossProjectiles.push_back({enemyFrontIndex, (int)random(1,4)}); // Only RGB colors
            boss3State = B3_SPIN;
          }
        }
      }
      
      // BOSS MOVEMENT - Only start moving boss 2 seconds after level begins
      if (millis() - levelStartTime > 2000) {
        // Move boss towards player with proper speed progression
        float bossSpeed = 0.7 + (currentLevel * 0.4); // Even slower for boss levels
        float bStep = bossSpeed / 60.0; // Convert to step size (original formula)
        
        enemyFrontIndex -= bStep;
        
        // Check if any active boss segments have reached the player
        bool gameOver = false;
        for (const auto& seg : bossSegments) {
          if (seg.active && seg.position <= 5) { // Active boss segment reached player area
            gameOver = true;
            break;
          }
        }
        
        if (gameOver) {
          // Trigger game over only when active boss segments reach the player
          currentState = STATE_LOSE_SCREEN;
          stateStartTime = millis();
        }
        
        // Update all boss segment positions relative to enemyFrontIndex
        for (auto& seg : bossSegments) {
          seg.position = enemyFrontIndex + seg.originalIndex * 5;
        }
      }
      
      moveBossProjectiles(deltaTime);
      checkWinCondition();
      checkLoseCondition();
      break;
    }
      
    case STATE_WIN_SCREEN:
      if (now - stateStartTime > 4000) {
        currentLevel++;
        updateLevelPalette(); // Update palette for new level
        currentState = STATE_LEVEL_INTRO;
        stateStartTime = now;
      }
      break;
      
    case STATE_LOSE_SCREEN:
      if (now - stateStartTime > 4000) {
        currentState = STATE_MAIN_MENU;
        stateStartTime = now;
      }
      break;
  }
  
  // --------------------------------------------------------------------------
  // 8. RENDERING
  // --------------------------------------------------------------------------
  FastLED.clear();
  
  switch(currentState) {
    case STATE_MAIN_MENU:
      // Spectacular attract mode
      {
        // Flowing rainbow wave background
        for(int i = 0; i < config_num_leds; i++) {
          uint8_t wave = sin8(((i * 256 / config_num_leds) + (now / 8)) % 256);
          leds[i] = ColorFromPalette(RainbowColors_p, wave, 200, LINEARBLEND);
        }
        
        // Pulsing brightness zones
        uint8_t pulse1 = beatsin8(30, 100, 255);
        uint8_t pulse2 = beatsin8(45, 100, 255);
        for(int i = 0; i < config_num_leds/3; i++) {
          leds[i].nscale8(pulse1);
        }
        for(int i = config_num_leds*2/3; i < config_num_leds; i++) {
          leds[i].nscale8(pulse2);
        }
        
        // Random sparkles to attract attention
        if (random8() < 50) {
          leds[random16(config_num_leds)] = CRGB::White;
        }
        
        // "PRESS TO PLAY" indicator (center pulsing)
        int center = config_num_leds / 2;
        uint8_t brightness = beatsin8(15, 80, 255);
        for(int i = -5; i <= 5; i++) {
          if (center + i >= 0 && center + i < config_num_leds) {
            leds[center + i] += CHSV(gHue, 255, brightness);
          }
        }
      }
      break;
      
    case STATE_LEVEL_INTRO:
      // Spectacular level intro with rainbow wave
      {
        // Dynamic rainbow sweep
        for (int i = 0; i < config_num_leds; i++) {
          uint8_t wave = sin8(((i * 256 / config_num_leds) + (now / 6)) % 256);
          leds[i] = CHSV(wave, 255, 200);
        }
        
        // Level number display overlay with pulsing white indicators
        int levelStart = (config_num_leds / 2) - (currentLevel * 3);
        uint8_t levelBrightness = beatsin8(20, 150, 255);
        for (int i = 0; i < currentLevel && i < 10; i++) {
          int pos = levelStart + (i * 6);
          if (pos >= 0 && pos < config_num_leds) {
            // Bright level indicators
            for (int j = 0; j < 3; j++) {
              if (pos + j < config_num_leds && pos + j >= 0) {
                leds[pos + j] = CRGB(levelBrightness, levelBrightness, levelBrightness);
              }
            }
          }
        }
      }
      break;
      
    case STATE_PLAYING:
      // Render enemies with enhanced effects
      for(int i=0; i<enemies.size(); i++) {
        if (enemies[i].active && enemies[i].position >= 0 && enemies[i].position < config_num_leds) {
          int pos = (int)enemies[i].position;
          
          // Main enemy with pulsing brightness and enhanced color
          uint8_t brightness = beatsin8(60, 150, 255);
          leds[pos] = ColorFromPalette(currentPalette, 
                                      map(enemies[i].color, 1, 3, 0, 240), 
                                      brightness, currentBlending);
          
          // Menacing glow around enemy
          for (int glow = -1; glow <= 1; glow++) {
            if (pos + glow >= 0 && pos + glow < config_num_leds && glow != 0) {
              leds[pos + glow] += ColorFromPalette(currentPalette, 
                                                  map(enemies[i].color, 1, 3, 0, 240), 
                                                  50, currentBlending);
            }
          }
        }
      }
      break;
      
    case STATE_BOSS_INTRO:
      // Boss intro animation
      for(int i=0; i<config_num_leds; i++) {
        if ((now/100 + i/5) % 2) leds[i] = cBoss;
      }
      break;
      
    case STATE_BOSS_PLAYING:
      {
        // Boss-specific background effects
        int bossNumber = currentLevel / 5;
        
        if (bossNumber == 1) {
          // Boss 1 - Fire Theme: Heat simulation background
          static uint8_t heat[100];
          
          // Cool down every cell a little
          for (int i = 0; i < config_num_leds; i++) {
            heat[i] = qsub8(heat[i], random8(0, ((55 * 10) / config_num_leds) + 2));
          }
          
          // Heat from each cell drifts 'up' and diffuses a little
          for (int k = config_num_leds - 1; k >= 2; k--) {
            heat[k] = (heat[k - 1] + heat[k - 2] + heat[k - 2]) / 3;
          }
          
          // Randomly ignite new 'sparks'
          if (random8() < 120) {
            int sparkPos = random8(7);
            heat[sparkPos] = qadd8(heat[sparkPos], random8(160, 255));
          }
          
          // Map heat to LED colors
          for (int j = 0; j < config_num_leds; j++) {
            leds[j] = HeatColor(heat[j]);
          }
        }
        else if (bossNumber == 2) {
          // Boss 2 - Lightning/Electric Theme
          fadeToBlackBy(leds, config_num_leds, 30);
          
          // Random lightning strikes
          if (random8() < 30) {
            int strike = random16(config_num_leds);
            for (int i = -2; i <= 2; i++) {
              if (strike + i >= 0 && strike + i < config_num_leds) {
                leds[strike + i] = CRGB(255, 255, 255);
              }
            }
          }
          
          // Electric blue shimmer
          for (int i = 0; i < config_num_leds; i += 3) {
            if (beatsin8(40 + i, 0, 255) > 200) {
              leds[i] = CRGB(0, 100, 255);
            }
          }
        }
        else {
          // Boss 3+ - Psychedelic/Chaos Theme
          for (int i = 0; i < config_num_leds; i++) {
            uint8_t noise = inoise8(i * 50, millis() / 5);
            leds[i] = ColorFromPalette(RainbowColors_p, noise, 255, LINEARBLEND);
          }
          
          // Spinning color wheels
          uint8_t spin = millis() / 20;
          for (int wheel = 0; wheel < 3; wheel++) {
            int center = wheel * (config_num_leds / 3);
            for (int i = 0; i < 10; i++) {
              int pos = center + i;
              if (pos < config_num_leds) {
                leds[pos] = CHSV(spin + wheel * 85, 255, 200);
              }
            }
          }
        }
        
        // Render boss segments with enhanced effects
        for(int i=0; i<bossSegments.size(); i++) {
          if (bossSegments[i].active && bossSegments[i].position >= 0 && bossSegments[i].position < config_num_leds) {
            int pos = (int)bossSegments[i].position;
            
            // Pulsing boss segments with enhanced colors
            uint8_t bossBrightness = beatsin8(40, 200, 255);
            leds[pos] = ColorFromPalette(currentPalette, 
                                        map(bossSegments[i].color, 1, 3, 0, 240), 
                                        bossBrightness, currentBlending);
            
            // Boss segment glow
            for (int glow = -2; glow <= 2; glow++) {
              if (pos + glow >= 0 && pos + glow < config_num_leds && glow != 0) {
                leds[pos + glow] += ColorFromPalette(currentPalette, 
                                                    map(bossSegments[i].color, 1, 3, 0, 240), 
                                                    80 - abs(glow * 30), currentBlending);
              }
            }
          }
        }
        
        // Render boss projectiles with enhanced effects
        for(auto &p : bossProjectiles) {
          if (p.position >= 0 && p.position < config_num_leds) {
            int pos = (int)p.position;
            leds[pos] = ColorFromPalette(currentPalette, 
                                        map(p.color, 1, 3, 0, 240), 
                                        255, currentBlending);
            
            // Projectile trail
            if (pos - 1 >= 0) {
              leds[pos - 1] += ColorFromPalette(currentPalette, 
                                              map(p.color, 1, 3, 0, 240), 
                                              100, currentBlending);
            }
          }
        }
      }
      break;
      
    case STATE_WIN_SCREEN:
      // Victory fireworks spectacular!
      {
        // Fade background for sparkle effect
        fadeToBlackBy(leds, config_num_leds, 20);
        
        // Multiple burst points with expanding rings
        for (int burst = 0; burst < 3; burst++) {
          int center = (burst + 1) * (config_num_leds / 4);
          int radius = beatsin8(30 + burst * 10, 5, 15);
          
          for (int i = -radius; i <= radius; i++) {
            int pos = center + i;
            if (pos >= 0 && pos < config_num_leds) {
              uint8_t brightness = 255 - abs(i * 15);
              leds[pos] += CHSV(gHue + burst * 80, 255, brightness);
            }
          }
        }
        
        // Victory sparkles rain
        for (int i = 0; i < 5; i++) {
          if (random8() < 80) {
            leds[random16(config_num_leds)] += CRGB::White;
          }
        }
        
        // Center victory blast
        int center = config_num_leds / 2;
        uint8_t victoryPulse = beatsin8(25, 100, 255);
        for (int i = -8; i <= 8; i++) {
          if (center + i >= 0 && center + i < config_num_leds) {
            leds[center + i] += CHSV(gHue, 200, victoryPulse - abs(i * 20));
          }
        }
      }
      break;
      
    case STATE_LOSE_SCREEN:
      // Game over animation
      for(int i=0; i<config_num_leds; i++) {
        if ((now/100) % 2) leds[i] = c2;
      }
      break;
  }
  
  // Render shots with trails
  for(auto &s : shots) {
    if (s.position >= 0 && s.position < config_num_leds) {
      // Main projectile with enhanced color
      leds[(int)s.position] = getEnhancedColor(s.color);
      
      // Trailing sparkles
      for (int trail = 1; trail <= 3; trail++) {
        int trailPos = (int)s.position - trail;
        if (trailPos >= 0) {
          uint8_t trailBrightness = 255 - (trail * 60);
          leds[trailPos] += ColorFromPalette(currentPalette, 
                                            map(s.color, 1, 3, 0, 240), 
                                            trailBrightness, currentBlending);
        }
      }
    }
  }

  // Update global effects
  EVERY_N_MILLISECONDS(20) { gHue++; } // Rainbow cycling
  
  // Render player
  if (playerPosition >= 0 && playerPosition < config_num_leds) {
    leds[playerPosition] = CRGB::White;
  }
  
  FastLED.show();
  
  // Feed watchdog to prevent boot loops
  delay(1);
}