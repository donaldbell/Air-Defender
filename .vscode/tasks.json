{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Upload Console",
			"type": "shell",
			"command": "platformio",
			"args": [
				"run",
				"--target",
				"upload",
				"--environment",
				"console"
			],
			"group": "build"
		},
		{
			"label": "Upload Display",
			"type": "shell",
			"command": "platformio",
			"args": [
				"run",
				"--target",
				"upload",
				"--environment",
				"display"
			],
			"group": "build"
		},
		{
			"label": "Monitor Console",
			"type": "shell",
			"command": "platformio",
			"args": [
				"device",
				"monitor",
				"--environment",
				"console"
			],
			"isBackground": true,
			"group": "monitor"
		},
		{
			"label": "Monitor Display",
			"type": "shell",
			"command": "platformio",
			"args": [
				"device",
				"monitor",
				"--environment",
				"display"
			],
			"isBackground": true,
			"group": "monitor"
		}
	]
}