{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Upload Console",
			"type": "shell",
			"command": "platformio",
			"args": [
				"run",
				"--target",
				"upload",
				"--environment",
				"console"
			],
			"group": "build"
		},
		{
			"label": "Upload Controller",
			"type": "shell",
			"command": "platformio",
			"args": [
				"run",
				"--target",
				"upload",
				"--environment",
				"controller"
			],
			"group": "build"
		},
		{
			"label": "Monitor Console",
			"type": "shell",
			"command": "platformio",
			"args": [
				"device",
				"monitor",
				"--environment",
				"console"
			],
			"isBackground": true,
			"group": "monitor"
		},
		{
			"label": "Monitor Controller",
			"type": "shell",
			"command": "platformio",
			"args": [
				"device",
				"monitor",
				"--environment",
				"controller"
			],
			"isBackground": true,
			"group": "monitor"
		},
		{
			"label": "Build All Environments",
			"type": "shell",
			"command": "platformio",
			"args": [
				"run"
			],
			"group": "build"
		},
		{
			"label": "Build Controller Test",
			"type": "shell",
			"command": "pio run --environment controller",
			"group": "build"
		}
	]
}