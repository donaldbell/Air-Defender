		},
		{
			"label": "Upload WiFi Test to Clean Board",
			"type": "shell",
			"command": "~/.platformio/penv/bin/platformio",
			"args": [
				"run",
				"--target",
				"upload",
				"--environment",
				"wifi_test",
				"--upload-port",
				"/dev/cu.usbserial-0001"
			]
		},
		{
